<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneDef>
    <defName>Rimverse_Gene_SlowBreathing</defName>
    <label>slow breathing</label>
    <labelShortAdj>slow-breathing</labelShortAdj>
    <description>Efficient lungs and a slow metabolism. Uses less ship air and resists hypoxia.</description>
    <iconPath>Rimverse/UI/Gene/Gene_SlowBreathing</iconPath>
    <iconColor>(0.7,0.9,0.9)</iconColor>
    <displayCategory>Rimverse_Lineages</displayCategory>
    <displayOrderInCategory>200</displayOrderInCategory>
    <statFactors>
      <MoveSpeed>0.97</MoveSpeed>
    </statFactors>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <modExtensions>
      <li Class="Rimverse.GeneSpaceExtension">
        <airFactor>0.6</airFactor>
        <hypoxiaFactor>0.5</hypoxiaFactor>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>Rimverse_Gene_RadiationSkin</defName>
    <label>radiation skin</label>
    <labelShortAdj>rad-skinned</labelShortAdj>
    <description>Thick, pigmented skin that blocks hard radiation and toxic fallout.</description>
    <iconPath>Rimverse/UI/Gene/Gene_RadiationSkin</iconPath>
    <iconColor>(0.7,0.9,0.9)</iconColor>
    <displayCategory>Rimverse_Lineages</displayCategory>
    <displayOrderInCategory>210</displayOrderInCategory>
    <statOffsets>
      <ToxicEnvironmentResistance>0.5</ToxicEnvironmentResistance>
      <ToxicResistance>0.25</ToxicResistance>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
  </GeneDef>

  <GeneDef>
    <defName>Rimverse_Gene_PerfectBalance</defName>
    <label>perfect balance</label>
    <labelShortAdj>balanced</labelShortAdj>
    <description>An inner ear that never gets confused. Zero gravity and low gravity do not bother them.</description>
    <iconPath>Rimverse/UI/Gene/Gene_PerfectBalance</iconPath>
    <iconColor>(0.7,0.9,0.9)</iconColor>
    <displayCategory>Rimverse_Lineages</displayCategory>
    <displayOrderInCategory>220</displayOrderInCategory>
    <statOffsets>
      <MoveSpeed>0.1</MoveSpeed>
    </statOffsets>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <modExtensions>
      <li Class="Rimverse.GeneSpaceExtension">
        <zeroGAdapted>true</zeroGAdapted>
        <noClumsy>true</noClumsy>
        <crushBonus>0.2</crushBonus>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef>
    <defName>Rimverse_Gene_Hibernation</defName>
    <label>hibernation</label>
    <labelShortAdj>hibernating</labelShortAdj>
    <description>They slow down during long trips: more tolerance for cold rooms and far less cabin fever, but they sleep more.</description>
    <iconPath>Rimverse/UI/Gene/Gene_Hibernation</iconPath>
    <iconColor>(0.7,0.9,0.9)</iconColor>
    <displayCategory>Rimverse_Lineages</displayCategory>
    <displayOrderInCategory>230</displayOrderInCategory>
    <statFactors>
      <RestFallRateFactor>1.2</RestFallRateFactor>
    </statFactors>
    <statOffsets>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <modExtensions>
      <li Class="Rimverse.GeneSpaceExtension">
        <cabinFeverFactor>0.4</cabinFeverFactor>
      </li>
    </modExtensions>
  </GeneDef>

