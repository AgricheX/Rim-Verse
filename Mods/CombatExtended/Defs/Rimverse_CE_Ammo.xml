			<texPath>Rimverse/Things/Projectile/Net</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Blunt</damageDef>
			<damageAmountBase>4</damageAmountBase>
			<armorPenetrationBlunt>2</armorPenetrationBlunt>
			<speed>25</speed>
			<secondaryDamage>
				<li>
					<def>Stun</def>
					<amount>12</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseBulletCE">
		<defName>Rimverse_CE_Bullet_Dart</defName>
		<label>dart</label>
		<graphicData>
			<texPath>Rimverse/Things/Projectile/Dart</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bullet</damageDef>
			<damageAmountBase>6</damageAmountBase>
			<armorPenetrationSharp>4</armorPenetrationSharp>
			<armorPenetrationBlunt>1</armorPenetrationBlunt>
			<speed>120</speed>
			<secondaryDamage>
				<li>
					<def>Rimverse_SedativeDart</def>
					<amount>10</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>Rimverse_CE_Bullet_Foam</defName>
		<label>foam canister</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Rimverse/Things/Projectile/Foam</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>Transparent</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Extinguish</damageDef>
			<damageAmountBase>1</damageAmountBase>
			<explosionRadius>1.5</explosionRadius>
			<speed>25</speed>
			<postExplosionSpawnThingDef>Filth_FireFoam</postExplosionSpawnThingDef>
			<postExplosionSpawnChance>1</postExplosionSpawnChance>
			<postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<suppressionFactor>0</suppressionFactor>
			<dangerFactor>0</dangerFactor>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>Rimverse_CE_Bullet_PlasmaThrower</defName>
		<label>plasma jet</label>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<graphicData>
			<texPath>Rimverse/Things/Projectile/Plasma</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>MoteGlow</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Flame</damageDef>
			<damageAmountBase>14</damageAmountBase>
			<explosionRadius>1.4</explosionRadius>
			<speed>35</speed>
			<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
			<ai_IsIncendiary>true</ai_IsIncendiary>
		</projectile>
	</ThingDef>

