  <ScenarioDef ParentName="ScenarioBase">
    <defName>Rimverse_GravshipTravelers</defName>
    <label>Gravship travelers</label>
    <description>Your crew lives aboard an old gravship docked at an orbital relay. It can hop between the planet and its orbit, but it will never reach the stars. Somewhere out there are civilizations, gates and whole galaxies. Build your first real starship: put a Rimverse bridge on the substructure, add engines and life support, and leave this world behind.</description>
    <scenario>
      <summary>Four travelers with a gravship who must build their first true starship.</summary>
      <playerFaction>
        <factionDef>GravshipCrew</factionDef>
      </playerFaction>
      <parts Inherit="False">
        <li Class="ScenPart_PlanetLayer">
          <def>PlanetLayerFixed</def>
          <tag>Orbit</tag>
          <layer>Orbit</layer>
          <settingsDef>Orbit</settingsDef>
          <hide>true</hide>
          <connections>
            <Surface>
              <zoomMode>ZoomIn</zoomMode>
            </Surface>
          </connections>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>Rimverse_ScenGravshipIntro</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>4</pawnCount>
          <pawnChoiceCount>8</pawnChoiceCount>
          <allowedDevelopmentalStages>Adult, Child</allowedDevelopmentalStages>
          <requiredSkills>
            <li>Construction</li>
          </requiredSkills>
        </li>
        <li Class="ScenPart_ForcedMap">
          <def>ForcedMap</def>
          <mapGenerator>OrbitalRelay</mapGenerator>
          <layerDef>Orbit</layerDef>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Gravship</method>
        </li>
        <li Class="ScenPart_DisableQuest">
          <def>DisableQuest</def>
          <questDef>MechanoidSignal</questDef>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>BasicGravtech</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Rimverse_ShipBasics</project>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Chemfuel</thingDef><count>250</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef><count>60</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef><count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef><count>50</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef><count>500</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Plasteel</thingDef><count>80</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_AssaultRifle</thingDef>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_Autopistol</thingDef>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>GravlitePanel</thingDef>
          <count>300</count>
          <allowRoofed>false</allowRoofed>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
