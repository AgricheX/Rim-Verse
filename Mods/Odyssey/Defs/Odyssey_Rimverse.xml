<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <PlanetLayerDef ParentName="OrbitLayer">
    <defName>Rimverse_MoonLayer</defName>
    <label>moon</label>
    <viewGizmoTooltip>View the moon of this world.</viewGizmoTooltip>
    <elevationString>200000km</elevationString>
    <defaultBiome>Orbit</defaultBiome>
    <rangeDistanceFactor>25</rangeDistanceFactor>
    <settlementsPer100kTiles>0~0</settlementsPer100kTiles>
    <worldGenSteps Inherit="False">
      <li>Tiles</li>
    </worldGenSteps>
  </PlanetLayerDef>

  <PlanetLayerDef ParentName="OrbitLayer">
