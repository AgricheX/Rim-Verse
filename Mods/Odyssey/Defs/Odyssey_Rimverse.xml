  <IncidentDef>
    <defName>Rimverse_OrbitCivTrader</defName>
    <label>orbital civilization trader</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Rimverse.IncidentWorker_OrbitCivTrader</workerClass>
    <baseChance>1.2</baseChance>
    <minRefireDays>10</minRefireDays>
    <canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
  </IncidentDef>

  <IncidentDef>
    <defName>Rimverse_OrbitCivPatrol</defName>
    <label>civilization patrol</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Rimverse.IncidentWorker_OrbitCivPatrol</workerClass>
    <baseChance>0.8</baseChance>
    <minRefireDays>15</minRefireDays>
    <canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
