<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Rimverse_HibernaGroggy</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>hiberna grogginess</label>
    <description>Stiff limbs after a long hiberna sleep. Fades after a day.</description>
    <defaultLabelColor>(0.6,0.7,0.9)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
