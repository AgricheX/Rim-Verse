<Defs>

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Rimverse_LineageGarb_Gravitated</defName>
    <label>gravity harness</label>
    <description>A reinforced work outfit from heavy-gravity worlds, cut to carry loads.</description>
    <techLevel>Industrial</techLevel>
    <recipeMaker>
      <researchPrerequisite>Rimverse_CrewClothing</researchPrerequisite>
    </recipeMaker>
    <graphicData>
      <texPath>Rimverse/Things/Apparel/MarineFatigues/MarineFatigues</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToMake>6500</WorkToMake>
      <Mass>0.9</Mass>
      <StuffEffectMultiplierArmor>0.4</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.2</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <CarryingCapacity>20</CarryingCapacity>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Rimverse/Things/Apparel/MarineFatigues/MarineFatigues</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Rimverse_Lineage</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.42,0.38,0.32,1)</only>
        </li>
      </options>
    </colorGenerator>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
  </ThingDef>

