<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef Name="Rimverse_ShipModuleBase" ParentName="BuildingBase" Abstract="True">
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.8</fillPercent>
    <rotatable>false</rotatable>
    <designationCategory>Rimverse_Ship</designationCategory>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>Rimverse.PlaceWorker_OnHull</li>
    </placeWorkers>
    <tickerType>Normal</tickerType>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

  <ThingDef ParentName="Rimverse_ShipModuleBase">
    <defName>Rimverse_BridgeSmall</defName>
    <techLevel>Industrial</techLevel>
    <label>small bridge</label>
    <description>Ship computer and helm. Defines a ship: every hull cell connected to it, up to 400 cells, becomes one ship. Launch, landing and the ship tab are here.</description>
    <graphicData>
      <texPath>Rimverse/Things/Building/Ship/BridgeSmall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Rimverse_ShipBasics</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <inspectorTabs>
      <li>Rimverse.ITab_RimverseShip</li>
    </inspectorTabs>
    <comps>
      <li Class="Rimverse.CompProperties_ShipPart">
        <role>Bridge</role>
        <mass>5</mass>
        <maxCells>400</maxCells>
        <essential>true</essential>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
  </ThingDef>

