  <ThingDef ParentName="BuildingBase">
    <defName>Rimverse_CargoCrate</defName>
    <techLevel>Industrial</techLevel>
    <label>cargo crate</label>
    <description>A cheap steel crate bolted to the deck. Holds 4 stacks.</description>
    <thingClass>Building_Storage</thingClass>
    <graphicData>
      <texPath>Rimverse/Things/Building/Ship/CargoCrate</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(0.55,0.5,0.42)</color>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <defaultPlacingRot>South</defaultPlacingRot>
    <canOverlapZones>false</canOverlapZones>
    <surfaceType>Item</surfaceType>
    <costList>
      <Steel>30</Steel>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>4</maxItemsInCell>
      <blueprintClass>Blueprint_Storage</blueprintClass>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Root</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Preferred</priority>
        <filter>
          <categories>
            <li>Foods</li>
            <li>Manufactured</li>
            <li>ResourcesRaw</li>
            <li>Items</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <designationCategory>Rimverse_Ship</designationCategory>
    <researchPrerequisites>
      <li>Rimverse_ShipStorage</li>
    </researchPrerequisites>
    <comps>
      <li Class="Rimverse.CompProperties_ShipPart">
        <role>Cargo</role>
        <mass>1</mass>
        <cargoTons>2</cargoTons>
      </li>
    </comps>
    <designatorDropdown>Rimverse_Dropdown_Cargo</designatorDropdown>
  </ThingDef>

