  <ThingDef ParentName="Rimverse_ShipModuleBase">
    <defName>Rimverse_Autocannon</defName>
    <label>ship autocannon</label>
    <description>Rapid-fire hull gun for close range. Bursts of 5 shells of 15 damage every 4 seconds. Uses 5 steel per burst.</description>
    <graphicData>
      <texPath>Rimverse/Things/Building/Ship/Autocannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <researchPrerequisites>
      <li>Rimverse_KineticWeapons</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <comps>
      <li Class="Rimverse.CompProperties_ShipPart">
        <role>Weapon</role>
        <mass>4</mass>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="Rimverse.CompProperties_ShipWeapon">
        <band>Near</band>
        <projectile>Rimverse_Proj_Autocannon</projectile>
        <burst>5</burst>
        <damage>15</damage>
        <cooldownSeconds>4</cooldownSeconds>
        <heatPerShot>1</heatPerShot>
        <ammoPerShot>5</ammoPerShot>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>100</fuelCapacity>
        <fuelLabel>steel</fuelLabel>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <initialFuelPercent>0</initialFuelPercent>
      </li>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
  </ThingDef>

