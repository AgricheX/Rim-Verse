<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>Rimverse_TradeTerminal</defName>
    <label>trade terminal</label>
    <description>A counter with a manifest screen, linked to the hold of the ship or station it stands in. Walk up to it to trade with whoever runs that hold.</description>
    <thingClass>Rimverse.Building_TradeTerminal</thingClass>
    <graphicData>
      <texPath>Rimverse/Things/Building/Mega/TradeTerminal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
    </graphicData>
    <size>(2,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <rotatable>true</rotatable>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <building>
      <deconstructible>false</deconstructible>
    </building>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(255,210,120,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <GenStepDef>
    <defName>Rimverse_SurfaceSettlement</defName>
    <order>950</order>
    <genStep Class="Rimverse.GenStep_SurfaceSettlement" />
  </GenStepDef>

  <JobDef>
    <defName>Rimverse_UseTradeTerminal</defName>
    <driverClass>Rimverse.JobDriver_UseTradeTerminal</driverClass>
    <reportString>trading at TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
