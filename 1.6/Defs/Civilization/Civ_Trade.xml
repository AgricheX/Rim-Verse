<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>Rimverse_OrbitalCredit</defName>
    <label>orbital credit</label>
    <description>A light, encrypted chip worth 10 silver. Stations, orbital traders and star civilizations use it instead of heavy silver.</description>
    <graphicData>
      <texPath>Rimverse/Things/Item/Resource/OrbitalCredit</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.55, 0.85, 1)</color>
    </graphicData>
    <stackLimit>1000</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>10</MarketValue>
      <Mass>0.001</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeTags>
      <li>Rimverse_Currency</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>Rimverse_StellarMark</defName>
    <label>stellar mark</label>
    <description>A sealed chip worth 100 silver, used for trade between stars.</description>
    <graphicData>
      <texPath>Rimverse/Things/Item/Resource/StellarMark</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(0.75, 0.6, 1)</color>
    </graphicData>
    <stackLimit>500</stackLimit>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>100</MarketValue>
      <Mass>0.001</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeTags>
      <li>Rimverse_Currency</li>
    </tradeTags>
  </ThingDef>

  <TraderKindDef>
    <defName>Rimverse_CivSpaceTrader</defName>
    <label>star civilization trader</label>
    <orbital>true</orbital>
    <commonality>0</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>500~1500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Rimverse_OrbitalCredit</thingDef>
        <countRange>100~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Rimverse_StellarMark</thingDef>
        <countRange>10~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>300~900</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Rimverse_WarpMatter</thingDef>
        <countRange>20~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>400~1000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Plasteel</thingDef>
        <countRange>100~300</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Uranium</thingDef>
        <countRange>30~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>20~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>2~6</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>20~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MealSurvivalPack</thingDef>
        <countRange>40~120</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Rimverse_SuitWork</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Rimverse_HelmetVacuum</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Rimverse_Currency</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
