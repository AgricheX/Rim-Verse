  <ThingDef ParentName="ResourceBase">
    <defName>Rimverse_ContractChip</defName>
    <label>contract chip</label>
    <description>A sealed data chip from a contract broker. Read it to receive a random contract: delivery, escort, survey, hunt and more, each with a deadline and a reward.</description>
    <graphicData>
      <texPath>Rimverse/Things/Item/Resource/OrbitalCredit</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(1, 0.8, 0.35)</color>
    </graphicData>
    <stackLimit>10</stackLimit>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MarketValue>60</MarketValue>
      <Mass>0.01</Mass>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Read contract</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>Rimverse.CompUseEffect_RimverseContract</compClass>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>
