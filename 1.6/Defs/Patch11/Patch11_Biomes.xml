  <BiomeDef>
    <defName>Rimverse_TwilightBand</defName>
    <label>twilight band</label>
    <description>The thin ring between eternal day and eternal night on a tidally locked world. Life clings to it.</description>
    <workerClass>Rimverse.BiomeWorker_RimverseSpace</workerClass>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0.6</animalDensity>
    <plantDensity>0.6</plantDensity>
    <inVacuum>false</inVacuum>
    <canAutoChoose>false</canAutoChoose>
    <allowRoads>false</allowRoads>
    <allowRivers>false</allowRivers>
    <allowFarmingCamps>false</allowFarmingCamps>
    <hasVirtualPlants>false</hasVirtualPlants>
    <hasBedrock>true</hasBedrock>
    <canExitMap>false</canExitMap>
    <terrainsByFertility>
      <li>
        <terrain>Soil</terrain>
        <min>-999</min>
        <max>0.4</max>
      </li>
      <li>
        <terrain>Rimverse_FungalMat</terrain>
        <min>0.4</min>
        <max>0.75</max>
      </li>
      <li>
        <terrain>Gravel</terrain>
        <min>0.75</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <wildPlants>
      <Rimverse_Plant_AirMoss>2</Rimverse_Plant_AirMoss>
      <Rimverse_Plant_AlienLocal>1</Rimverse_Plant_AlienLocal>
      <Plant_Grass>2</Plant_Grass>
    </wildPlants>
    <baseWeatherCommonalities>
      <Clear>2</Clear>
      <Fog>1</Fog>
      <Rain>1</Rain>
    </baseWeatherCommonalities>
    <modExtensions>
      <li Class="Rimverse.BiomeFeatureExtension">
        <feature>Twilight</feature>
      </li>
    </modExtensions>
  </BiomeDef>

