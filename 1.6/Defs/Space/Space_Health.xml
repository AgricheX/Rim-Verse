<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <StatDef>
    <defName>Rimverse_VacuumSeal</defName>
    <label>vacuum seal</label>
    <description>How well this person is protected from vacuum. At 100% they can breathe and survive outside a pressurized room indefinitely.</description>
    <category>Apparel</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <maxValue>1</maxValue>
    <toStringStyle>PercentZero</toStringStyle>
    <showOnAnimals>false</showOnAnimals>
    <displayPriorityInCategory>3900</displayPriorityInCategory>
  </StatDef>

  <HediffDef>
    <defName>Rimverse_Hypoxia</defName>
    <label>hypoxia</label>
    <description>Lack of oxygen from thin or missing air. Mild hypoxia slows thought and movement. Severe hypoxia causes unconsciousness and then death.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 1)</defaultLabelColor>
    <lethalSeverity>1</lethalSeverity>
    <makesSickThought>false</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>mild</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>moderate</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>critical</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <setMax>0.2</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
