<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="EggFertBase">
    <defName>Rimverse_Egg_Skyfin</defName>
    <label>skyfin egg (fert.)</label>
    <description>A fertilized skyfin egg. If all goes well, it will hatch into a baby skyfin. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>Rimverse/Things/Item/Resource/AlienEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.75,0.85,1.0)</color>
    </graphicData>
    <statBases>
      <MarketValue>12</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>3.5</hatcherDaystoHatch>
        <hatcherPawn>Rimverse_Fauna_Skyfin</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

