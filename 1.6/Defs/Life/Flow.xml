  <ThingDef ParentName="ResourceBase">
    <defName>Rimverse_ResonanceShard</defName>
    <label>resonance shard</label>
    <description>A sliver of crystal that hums with the Great Flow. Held by a sensitive mind, it wakes the Flow inside them. Smiths also use it to focus beam blades.</description>
    <graphicData>
      <texPath>Rimverse/Things/Item/Resource/ResonanceShard</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MarketValue>1800</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.1</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <techLevel>Archotech</techLevel>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Attune to the Flow</useLabel>
        <useDuration>600</useDuration>
      </li>
      <li Class="Rimverse.CompProperties_UseEffectAwakenFlow" />
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>Rimverse_BeamBlade</defName>
    <label>beam blade</label>
    <description>A hilt that holds a blade of focused light, tuned by a resonance shard. It cuts through almost any armor. In the hands of someone sensitive to the Great Flow it feels alive.</description>
    <graphicData>
      <texPath>Rimverse/Things/Weapon/BeamBlade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <weaponTags>
      <li>Rimverse_BeamBlade</li>
    </weaponTags>
    <costList>
      <Plasteel>40</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <Rimverse_ResonanceShard>1</Rimverse_ResonanceShard>
    </costList>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>1</Mass>
      <MarketValue>4500</MarketValue>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <recipeMaker>
      <researchPrerequisite>Rimverse_ExoticMaterials</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>500</displayPriority>
    </recipeMaker>
    <tools>
      <li>
        <label>beam</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>26</power>
        <cooldownTime>1.5</cooldownTime>
        <armorPenetration>0.85</armorPenetration>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>22</power>
        <cooldownTime>1.4</cooldownTime>
        <armorPenetration>0.9</armorPenetration>
      </li>
    </tools>
  </ThingDef>

