<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Rimverse_FlowSensitive</defName>
    <label>Great Flow sensitive</label>
    <description>This person feels the Great Flow, the current that runs through every living thing. With training they can push, sense and shape it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(150,200,255)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.2</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_GiveAbility">
        <abilityDefs>
          <li>Rimverse_FlowPush</li>
          <li>Rimverse_FlowSense</li>
        </abilityDefs>
      </li>
    </comps>
  </HediffDef>

